{
    "name": "more-space",
    "version": "0.1.2",
    "description": "A chalkboard and an avatar for any terminal agent: it shows its plan, its progress and its questions while it works.",
    "license": "MIT",
    "author": "zohayrslileh",
    "homepage": "https://github.com/zohayrslileh/more-space",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zohayrslileh/more-space.git"
    },
    "bugs": "https://github.com/zohayrslileh/more-space/issues",
    "type": "module",
    "private": true,
    "main": "dist/main.js",
    "scripts": {
        "postinstall": "install-electron",
        "build": "bun scripts/build.ts",
        "start": "bun scripts/build.ts && electron .",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "check": "bun run typecheck && bun test && bun run build",
        "icon": "electron scripts/make-icon.mjs",
        "package": "bun scripts/build.ts && bun scripts/package.ts",
        "release": "bun scripts/build.ts && bun scripts/package.ts --publish"
    },
    "dependencies": {
        "node-pty": "^1.1.0"
    },
    "devDependencies": {
        "@fontsource/architects-daughter": "^5.3.0",
        "@fontsource/caveat": "^5.3.0",
        "@fontsource/gochi-hand": "^5.3.0",
        "@fontsource/ibm-plex-sans": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0",
        "@fontsource/kalam": "^5.3.0",
        "@fontsource/patrick-hand": "^5.3.0",
        "@fontsource/schoolbell": "^5.3.0",
        "@types/bun": "^1.4.2",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-webgl": "^0.19.0",
        "@xterm/xterm": "^6.0.0",
        "electron": "^44.5.1",
        "electron-builder": "^26.15.3",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "^7.0.2"
    },
    "trustedDependencies": [
        "node-pty"
    ]
}
